# Copy to .env.production on the server. Do not commit the real file.
POSTGRES_USER=hoopstars
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=hoopstars
DATABASE_SCHEMA=hoopstars

# Without a domain/TLS, use http://SERVER_IP:8080 and false.
# Behind an HTTPS reverse proxy, use https://your-domain.example and true.
APP_ORIGIN=http://SERVER_IP:8080
APP_PORT=8080
COOKIE_SECURE=false

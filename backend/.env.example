PORT=3001
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# PostgreSQL is required. URL-encode special characters in the password.
# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_DATABASE=bongro
# One-time import into an empty PostgreSQL schema; sources remain untouched.
IMPORT_LEGACY=true
LEGACY_SQLITE_FILE=./data/academy.sqlite
LEGACY_DATA_FILE=./data/academy.json
# Optional Docker setup: docker compose --env-file backend/.env up -d
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bongro
POSTGRES_PORT=5432
# Integration tests use a unique temporary schema. Optional separate database:
# TEST_DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/bongro_test

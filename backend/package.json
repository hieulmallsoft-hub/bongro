{
  "name": "@hoopstars/backend",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:status": "npm run build && node --env-file-if-exists=.env dist/storage/database-cli.js",
    "start": "npm run build && node --env-file-if-exists=.env dist/main.js",
    "dev": "npm run build && concurrently -k \"tsc --watch -p tsconfig.json\" \"node --env-file-if-exists=.env --watch dist/main.js\"",
    "test": "npm run build && node --env-file-if-exists=.env --test test/*.test.cjs",
    "test:local": "npm run build && node test/run-local-postgres.cjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.0"
  }
}
